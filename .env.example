# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Every variable here is server-only unless its name starts with NEXT_PUBLIC_.

# OpenAI API key. Used only inside route handlers; never sent to the browser.
OPENAI_API_KEY=

# Vision-capable chat model that supports Structured Outputs (JSON schema).
# Used for reading screenshots/photos and analysing text. Chosen in Phase 2.
OPENAI_MODEL=

# Speech-to-text model used to transcribe the parent's spoken description of a call.
OPENAI_TRANSCRIBE_MODEL=

# Supabase project URL (Project Settings > API).
SUPABASE_URL=

# Supabase service role key. Server-only: it bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=

# Long random string used to sign the family session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Public base URL of the deployed app, used to build the pairing QR code link.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Maximum /api/check and /api/transcribe requests per device or IP per hour.
RATE_LIMIT_PER_HOUR=30
