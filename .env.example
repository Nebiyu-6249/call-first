# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Every variable here is server-only: none of them is sent to the browser.

# OpenAI API key. Used only inside route handlers; never sent to the browser.
OPENAI_API_KEY=

# Vision-capable model that supports Structured Outputs (JSON schema), called via the
# Responses API. Used for reading screenshots/photos and analysing text.
# gpt-6.1-terra is OpenAI's fast model for visual reasoning (checked Nov 2026).
OPENAI_MODEL=gpt-6.1-terra

# Reasoning effort sent with each check. "none" keeps answers fast enough for the 8-second
# timeout. Leave empty to use the model's default (needed for models without "none").
OPENAI_REASONING_EFFORT=none

# Speech-to-text model used to transcribe the parent's spoken description of a call.
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe

# Supabase project URL (Project Settings > API).
SUPABASE_URL=

# Supabase service role key. Server-only: it bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=

# Long random string used to sign the family session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Maximum /api/check and /api/transcribe requests per internet address per hour (shared by both).
RATE_LIMIT_PER_HOUR=30
